{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Compola",
  "version": "0.1.6",
  "identifier": "app.compola.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:admin && npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Compola",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 8,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/compola-fingerprint-helper"
    ],
    "category": "SocialNetworking",
    "shortDescription": "A native-shell Zalo client",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMUE5OTQyMEUzMjAxOEQKUldTTkFUSU9RcGthdjhoRksyYWU0YnNDNTBYRk9uUTE0dlNqcUlaNE1CUGxFZGdsNXJlQVdUUHcK",
      "endpoints": [
        "https://github.com/DeanOpen/compola-client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
