# Compola gateway (see deploy/README.md).
#   SITE_ADDRESS      ":8080" or a domain (automatic HTTPS)
#   COMPOLA_UPSTREAM  the Compola Server host, e.g. http://192.168.1.20:39218
# Everything (admin console, web client, API, WebSocket, media, /healthz) is on ONE port: 8080 for plain HTTP, or
# 443 with a domain (the certificate is obtained over 443 itself with TLS-ALPN, so port 80 is optional).
{
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::8080} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# Liveness / readiness (Docker, Kubernetes, load balancers) on the same port as everything else.
	handle /healthz {
		respond "ok" 200
	}

	# Admin console, served from this image (same CSP as the host's own /admin).
	redir /admin /admin/ 308
	handle_path /admin/* {
		root * /srv/admin
		header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		@adminAssets path /assets/*
		header @adminAssets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	# Web client, served from this image.
	redir /web /web/ 308
	handle_path /web/* {
		root * /srv/web
		header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		@webAssets path /assets/*
		header @webAssets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	# Everything else goes to the Compola host: /api, /ws (WebSocket), /media, /upload, /info.
	# Caddy keeps the Host header and adds X-Forwarded-Host/-Proto, which the host's Origin check accepts.
	handle {
		reverse_proxy {$COMPOLA_UPSTREAM} {
			flush_interval -1
		}
	}
}

# Docker HEALTHCHECK only: loopback inside the container, never exposed or published. It answers the same way whether
# SITE_ADDRESS is :8080 or a domain (where 127.0.0.1 would not match the site).
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz "ok" 200
}
