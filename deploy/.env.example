# Compola Server on Linux + HTTPS gateway (deploy/docker-compose.yml). No Mac needed.

# First admin of Compola Server, created on the first start only: user:password. Change the password in /admin later.
COMPOLA_ADMIN=admin:change-me-now

# ":8080" = plain HTTP on HTTP_PORT (put your own TLS / load balancer in front).
# A domain, e.g. compola.example.com = Caddy obtains a Let's Encrypt certificate over port 443
# (publish 443:443 in docker-compose.yml instead of HTTP_PORT).
SITE_ADDRESS=:8080
HTTP_PORT=8080

# The address people use, for SSO redirects and device sign-in links (e.g. https://compola.example.com).
COMPOLA_PUBLIC_URL=

# Image tag for both images: latest (last release), edge (main), or a version such as 0.1.6.
COMPOLA_TAG=latest

# Gateway only (no "server" container): the Compola desktop app acting as host, Settings › Compola Server on with LAN
# access. Leave unset to use the Linux server container.
# COMPOLA_UPSTREAM=http://192.168.1.20:39218
